# Azure App Service application settings
# Set these values in Portal or via Azure CLI.

FLASK_SECRET_KEY=replace-with-strong-random-value
ADMIN_PASSWORD=replace-with-admin-password

# Option A (preferred): complete Redis URL
# Example: rediss://default:<password>@<name>.redis.cache.windows.net:6380/0
REDIS_URL=

# Option B: split Redis settings (used when REDIS_URL is empty)
REDIS_HOST=
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_USE_TLS=true
